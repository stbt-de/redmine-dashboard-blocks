<%# Tickets, die der Benutzer zuletzt angelegt, geändert oder kommentiert hat %>
<% issues = RedmineDashboardBlocks::RecentIssues.new(user).issues %>
<h3><%= l('my.blocks.recent_issues') %></h3>

<% if issues.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <ul class="dashboard-blocks-recent">
    <% issues.each do |issue| %>
      <li>
        <%= link_to issue_path(issue), title: "#{issue.project.name} · #{issue.status.name}",
                    class: "dashboard-blocks-recent-issue#{' dashboard-blocks-recent-closed' if issue.closed?}" do %>
          <%= dashboard_blocks_project_tile(issue.project, size: 18) %>
          <span>#<%= issue.id %> <%= issue.subject %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
