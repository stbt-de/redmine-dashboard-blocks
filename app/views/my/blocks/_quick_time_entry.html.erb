<%# Zeit buchen: Ticket suchen, Dauer wählen, buchen (dashboard_blocks.js) %>
<% quick = RedmineDashboardBlocks::QuickTimeEntry.new(user) %>
<% recent = quick.recent_issues %>
<h3>
  <%= l('my.blocks.quick_time_entry') %>
  <span class="dashboard-blocks-today">
    <%= l(:label_dashboard_blocks_today) %>
    <strong data-dashboard-today><%= dashboard_blocks_hours(quick.today_hours) %></strong>
  </span>
</h3>

<% if quick.allowed? %>
  <div class="dashboard-blocks-quick-time"
       data-urls="<%= { issues: dashboard_blocks_time_entry_issues_path, activities: dashboard_blocks_time_entry_activities_path,
                        create: dashboard_blocks_time_entries_path, destroy: dashboard_blocks_time_entry_path(id: 0) }.to_json %>"
       data-i18n="<%= { no_match: l(:label_dashboard_blocks_no_match), choose_issue: l(:error_dashboard_blocks_choose_issue),
                        undo: l(:button_dashboard_blocks_undo), undone: l(:notice_dashboard_blocks_undone),
                        open_form: l(:label_dashboard_blocks_open_form), failed: l(:error_dashboard_blocks_failed) }.to_json %>">
    <%= form_tag(dashboard_blocks_time_entries_path, class: 'dashboard-blocks-quick-time-form', autocomplete: 'off') do %>
      <%= hidden_field_tag :issue_id, '', id: "#{block}-issue-id" %>

      <div class="dashboard-blocks-field dashboard-blocks-issue">
        <label for="<%= block %>-issue"><%= l(:field_issue) %></label>
        <div class="dashboard-blocks-combobox">
          <input type="text" id="<%= block %>-issue" class="dashboard-blocks-issue-search"
                 placeholder="<%= l(:label_dashboard_blocks_search_placeholder) %>"
                 role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="<%= block %>-issue-options">
          <button type="button" class="dashboard-blocks-issue-clear icon-only" hidden
                  aria-label="<%= l(:button_dashboard_blocks_clear) %>" title="<%= l(:button_dashboard_blocks_clear) %>">×</button>
          <ul id="<%= block %>-issue-options" class="dashboard-blocks-issue-options" role="listbox" hidden></ul>
        </div>
      </div>

      <fieldset class="dashboard-blocks-field dashboard-blocks-duration">
        <legend><%= l(:field_hours) %></legend>
        <div class="dashboard-blocks-duration-choices">
          <% [0.25, 0.5, 1, 2].each do |hours| %>
            <button type="button" class="dashboard-blocks-duration-choice" data-hours="<%= format_hours(hours) %>"
                    aria-pressed="<%= hours == 1 %>"><%= format_hours(hours) %></button>
          <% end %>
          <%= text_field_tag :hours, format_hours(1), id: "#{block}-hours", class: 'dashboard-blocks-hours',
                             size: 5, inputmode: 'decimal', 'aria-label': l(:field_hours), required: true %>
        </div>
      </fieldset>

      <div class="dashboard-blocks-field">
        <label for="<%= block %>-spent-on"><%= l(:field_spent_on) %></label>
        <%= date_field_tag :spent_on, user.today, id: "#{block}-spent-on", max: user.today + 1, required: true %>
      </div>

      <div class="dashboard-blocks-field">
        <label for="<%= block %>-activity"><%= l(:field_activity) %></label>
        <%= select_tag :activity_id,
                       options_from_collection_for_select(quick.default_activities, :id, :name,
                                                          quick.default_activities.detect(&:is_default?)&.id),
                       id: "#{block}-activity", class: 'dashboard-blocks-activity' %>
      </div>

      <div class="dashboard-blocks-field dashboard-blocks-comment">
        <label for="<%= block %>-comments"><%= l(:field_comments) %></label>
        <%= text_field_tag :comments, '', id: "#{block}-comments", maxlength: 1024 %>
      </div>

      <div class="dashboard-blocks-field dashboard-blocks-submit">
        <%= submit_tag l(:button_dashboard_blocks_log), name: nil, class: 'button-positive' %>
      </div>
    <% end %>

    <p class="dashboard-blocks-quick-time-status" role="status" aria-live="polite" hidden></p>

    <% if recent.any? %>
      <div class="dashboard-blocks-recent">
        <span class="dashboard-blocks-recent-label"><%= l(:label_dashboard_blocks_recent) %></span>
        <% recent.each do |issue| %>
          <button type="button" class="dashboard-blocks-recent-issue" data-issue-id="<%= issue.id %>"
                  data-label="#<%= issue.id %> <%= issue.subject %>" title="<%= issue.project.name %>">
            <%= dashboard_blocks_project_tile(issue.project, size: 18) %>
            <span>#<%= issue.id %> <%= issue.subject %></span>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="nodata"><%= l(:label_dashboard_blocks_not_allowed) %></p>
<% end %>
