<%# Gebuchte Stunden einer Woche je Tag, gegen ein Wochenziel.
    Woche (params[:my_week_start]) und Benutzer (settings[:user_id]) kommen
    über das Formular unten: Redmine speichert die Einstellung und setzt den
    Block per Ajax neu ein (my/update_page); die Woche reist als Parameter mit. %>
<% users = RedmineDashboardBlocks::WeekSummary.selectable_users(user) %>
<% person = RedmineDashboardBlocks::WeekSummary.resolve_user(user, settings[:user_id]) %>
<% week = RedmineDashboardBlocks::WeekSummary.new(user, target: settings[:target_hours], user: person,
                                                  date: params[:my_week_start]) %>
<% top = week.top_project %>
<% schedule_editable = RedmineDashboardBlocks::WorkSchedule.editable?(user, person) %>
<% scale = [week.daily_target, week.days.map(&:hours).max.to_f].max %>

<div class="contextual">
  <%= link_to_function sprite_icon('settings', l(:label_options)), "$('##{block}-settings').toggle();",
                       class: 'icon-only icon-settings', title: l(:label_options) %>
</div>

<%# Mehrere Instanzen (my_week, my_week__1, …) unterscheiden sich am Namen %>
<h3>
  <%= week.own? ? l('my.blocks.my_week') : l(:label_dashboard_blocks_week_of, name: person.name) %>
  <span class="dashboard-blocks-week-total">
    <%= l(:label_dashboard_blocks_week_total, total: dashboard_blocks_hours(week.total), target: dashboard_blocks_hours(week.target)) %>
  </span>
</h3>

<div id="<%= block %>-settings" style="display: none;">
  <%= form_tag(my_page_path, remote: true) do %>
    <%= hidden_field_tag 'my_week_start', week.start.iso8601, id: nil %>
    <%= hidden_field_tag "settings[#{block}][user_id]", person.id, id: nil %>
    <% if schedule_editable %>
      <%# Arbeitszeit der gezeigten Person, Montag bis Sonntag %>
      <fieldset class="dashboard-blocks-work-hours">
        <legend><%= week.own? ? l(:label_dashboard_blocks_work_hours) : l(:label_dashboard_blocks_work_hours_of, name: person.name) %></legend>
        <% (1..7).each do |cwday| %>
          <% date = week.start + ((cwday - week.start.cwday) % 7) %>
          <label>
            <span><%= ::I18n.t('date.abbr_day_names')[cwday % 7] %></span>
            <%= number_field_tag "settings[#{block}][work_hours][#{cwday}]", format('%g', week.target_for(date).round(2)),
                                 id: nil, min: 0, max: 24, step: 0.25 %>
          </label>
        <% end %>
        <em class="info"><%= l(:text_dashboard_blocks_work_hours) %></em>
      </fieldset>
    <% elsif !week.scheduled? %>
      <p>
        <label for="<%= block %>-target"><%= l(:label_dashboard_blocks_week_target) %></label>
        <%= number_field_tag "settings[#{block}][target_hours]", week.target, id: "#{block}-target",
                             min: 1, max: 168, step: 0.5, size: 5 %>
      </p>
    <% else %>
      <p class="dashboard-blocks-work-hours-fixed"><%= l(:text_dashboard_blocks_work_hours_fixed, name: person.name) %></p>
    <% end %>
    <p>
      <%= submit_tag l(:button_save) %>
      <%= link_to_function l(:button_cancel), "$('##{block}-settings').toggle();" %>
    </p>
  <% end %>
</div>

<%= form_tag(my_page_path, remote: true, class: 'dashboard-blocks-week-nav') do %>
  <%= hidden_field_tag 'my_week_start', week.start.iso8601, id: nil %>
  <span class="dashboard-blocks-week-steps">
    <button type="submit" name="my_week_start" value="<%= week.previous_start.iso8601 %>"
            class="dashboard-blocks-week-step" title="<%= l(:label_dashboard_blocks_week_previous) %>"
            aria-label="<%= l(:label_dashboard_blocks_week_previous) %>"><%= sprite_icon('angle-left') %></button>
    <span class="dashboard-blocks-week-label">
      <strong><%= l(:label_dashboard_blocks_week_number, number: week.number) %></strong>
      <span><%= ::I18n.l(week.start, format: l(:date_format_dashboard_blocks_day)) %>–<%= ::I18n.l(week.finish, format: l(:date_format_dashboard_blocks_day)) %></span>
    </span>
    <button type="submit" name="my_week_start" value="<%= week.next_start.iso8601 %>"
            class="dashboard-blocks-week-step" title="<%= l(:label_dashboard_blocks_week_next) %>"
            aria-label="<%= l(:label_dashboard_blocks_week_next) %>"><%= sprite_icon('angle-right') %></button>
    <% unless week.current? %>
      <button type="submit" name="my_week_start" value="" class="dashboard-blocks-week-current">
        <%= l(:label_dashboard_blocks_week_current) %>
      </button>
    <% end %>
  </span>
  <% if users.size > 1 %>
    <label class="dashboard-blocks-week-user">
      <span class="dashboard-blocks-visually-hidden"><%= l(:label_dashboard_blocks_week_user) %></span>
      <%= select_tag "settings[#{block}][user_id]",
                     options_from_collection_for_select(users, :id, :name, person.id),
                     id: "#{block}-user" %>
    </label>
  <% else %>
    <%= hidden_field_tag "settings[#{block}][user_id]", person.id, id: nil %>
  <% end %>
<% end %>

<ol class="dashboard-blocks-week" aria-label="<%= l(:label_dashboard_blocks_week_chart) %>">
  <% week.days.each do |day| %>
    <li class="dashboard-blocks-day<%= ' dashboard-blocks-day-today' if day.today %>">
      <span class="dashboard-blocks-day-hours"><%= day.hours.positive? ? format_hours(day.hours) : '–' %></span>
      <span class="dashboard-blocks-day-bar" aria-hidden="true">
        <span style="height: <%= scale.positive? ? [(day.hours * 100.0 / scale).round, 100].min : 0 %>%"></span>
        <% if day.target.positive? && scale.positive? %>
          <i class="dashboard-blocks-day-target" style="bottom: <%= [(day.target * 100.0 / scale).round, 100].min %>%"></i>
        <% end %>
      </span>
      <span class="dashboard-blocks-day-name" title="<%= format_date(day.date) %><%= " · #{l(:label_dashboard_blocks_day_target, hours: dashboard_blocks_hours(day.target))}" if day.target.positive? %>"><%= ::I18n.t('date.abbr_day_names')[day.date.wday] %></span>
    </li>
  <% end %>
</ol>

<p class="dashboard-blocks-week-footer">
  <% if top %>
    <span><%= l(:label_dashboard_blocks_week_top_project, project: top.first.name, hours: dashboard_blocks_hours(top.last)) %></span>
  <% end %>
  <%= link_to l(:label_dashboard_blocks_week_entries),
              time_entries_path(set_filter: 1, f: %w[spent_on user_id], op: { spent_on: '><', user_id: '=' },
                                v: { spent_on: [week.start.iso8601, week.finish.iso8601], user_id: [person.id.to_s] }) %>
</p>
